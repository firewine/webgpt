# Copy to .env. Paths must be absolute. The application listens on loopback only.
WJ_HOST=127.0.0.1
WJ_PORT=3000
WJ_LOG_LEVEL=info
WJ_FAKE_DELAY_MS=100
WJ_PUBLIC_ORIGIN=http://127.0.0.1:3000
# Production example: https://your-server.your-tailnet.ts.net:8443
# WJ_STATE_DIR=/home/you/.local/state/webjjoku
# WJ_CHROME_PROFILE_DIR=/home/you/.local/share/webjjoku/chrome
# An owner key is generated in STATE_DIR/access-token (0600). No provider keys here.
WJ_SOURCE_FETCH=true
WJ_TURN_TIMEOUT_MS=300000
WJ_OAUTH_PORT=1455
# WJ_NOVNC_PORT=6080
# WJ_CHROME_COMMAND=["/absolute/path/chrome-devtools-mcp","--browserUrl=http://127.0.0.1:9222","--no-usage-statistics"]
# WJ_CODEX_COMMAND=["/absolute/path/codex","app-server"]
WJ_WORKSPACE_ROOTS=[]
# Optional desktop launch settings; command arguments use JSON arrays above:
# WJ_CHROME_BINARY=/usr/bin/google-chrome-stable
# WJ_NOVNC_WEB=/usr/share/novnc
