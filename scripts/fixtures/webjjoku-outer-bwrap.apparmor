# REVIEWED CANDIDATE: runtime stacking and final containment remain UNVERIFIED.
# Dedicated root-owned, non-setuid copy of the packaged bwrap binary.
# Trusted OUTER launcher only; never put this directory in the tools' PATH.
abi <abi/5.0>,
include <tunables/global>

profile webjjoku_outer_bwrap /usr/local/libexec/webjjoku/bwrap flags=(attach_disconnected,mediate_deleted) {
  allow capability,
  allow file rwlkm /{**,},
  allow network,
  allow unix,
  allow ptrace,
  allow signal,
  allow mqueue,
  allow io_uring,
  allow userns,
  allow mount,
  allow umount,
  allow pivot_root,
  allow dbus,

  # Keep the outer label through trusted children, including under NNP.
  allow pix /** -> &webjjoku_outer_bwrap,
  # Stock inner setup retains the outer label without an inheritance fallback.
  allow Px /usr/bin/bwrap -> webjjoku_outer_bwrap//&bwrap,
  # Descendants cannot re-enter this outer setup entry point.
  deny /usr/local/libexec/webjjoku/bwrap x,
}
